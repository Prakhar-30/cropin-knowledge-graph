{
  "name": "cropin-knowledge-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Configuration-assist knowledge graph for Cropin Cloud: ontology, ingestion pipeline, API and viewer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "graph": "tsx src/cli/index.ts",
    "build:demo": "tsx src/cli/index.ts build --source synthetic --tenant demo --out dist/demo/graph.json --pretty",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "dev:viewer": "vite --config viewer/vite.config.ts",
    "dev:api": "tsx watch src/server/index.ts",
    "api": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:viewer": "tsx tests/viewer.smoke.ts",
    "check": "tsc --noEmit && vitest run",
    "sql:masters": "tsx src/cli/index.ts sql --what masters --tenant demo",
    "build:supabase": "tsx src/cli/index.ts build --source supabase --mapping mappings/default.yaml --out dist/demo/graph.json --pretty --parity"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
