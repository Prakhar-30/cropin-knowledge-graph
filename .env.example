# Copy this file to .env and fill it in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Never put a real secret in THIS file. It is committed, and a secret committed once is a secret
# leaked - rotating it is the only fix. `npm run check:secrets` fails the build if one appears here.

# --- Reading: the platform masters and the graph store -------------------------
# The publishable (anon) key is designed to be public. It is protected by row level security, which
# supabase/schema.sql sets to select-only, so it can read everything this project creates and write
# nothing. That is the whole ingestion path: read-only by policy, not by convention.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Writing: seeding the fixture masters, and pushing a built graph ----------
# Only needed for `cropin-graph push`, which writes the built graph to its own kg_* tables and never
# back to a platform master. Leave it empty and use `cropin-graph sql --what graph` instead, which
# emits SQL to run in the Supabase editor - no write key required.
#
# PUT THIS IN .env, NEVER HERE.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ----------------------------------------------------------------
# A direct read-only Postgres connection, for a future source that issues SQL rather than PostgREST.
CROPIN_DB_URL=

PORT=8787
GRAPH_DIST_DIR=dist
